{% comment %}
Template: Almasoft Login
Input: msg.meta + msg.data.accessKod/loginTid
Output: Parameters resource with session values
{% endcomment %}

{%- assign meta = msg.meta -%}
{%- assign data = msg.data -%}

{
	"resourceType": "Parameters",
	"id": "{{ meta.requestId }}",
	"parameter": [
		{
			"name": "accessKod",
			"valueString": "{{ data.accessKod }}"
		},
		{
			"name": "loginTid",
			"valueString": "{{ data.loginTid }}"
		},
		{
			"name": "sourceSystem",
			"valueString": "{{ meta.sourceSystem | default: 'almasoft' }}"
		}
	]
}
