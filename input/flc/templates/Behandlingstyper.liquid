{% comment %}
Template: Almasoft Behandlingstyper
Input: msg.meta + msg.data.behandlingstyper[]
Output: ActivityDefinition Bundle (resource) or single ActivityDefinition (instance)
{% endcomment %}

{%- assign meta = msg.meta -%}
{%- assign procedures = msg.data.behandlingstyper | to_array -%}
{%- assign interaction_level = meta.interactionLevel | downcase -%}
{%- assign source_system = meta.sourceSystem | default: "almasoft" -%}
{%- assign last_updated = meta.extractDate | default: 'now' | date: "yyyy-MM-dd'T'HH:mm:sszzz" -%}

{%- if interaction_level == 'instance' -%}
{%- assign procedure = procedures.first -%}
{
	"resourceType": "ActivityDefinition",
	"id": "{{ procedure.kod }}",
	"status": "active",
	"title": "{{ procedure.namn }}",
	"name": "{{ procedure.namn | replace: ' ', '_' }}",
	"description": "Procedure from Almasoft behandlingstyper.",
	"code": {
		"text": "{{ procedure.namn }}"
	},
	"timingDuration": {
		"value": {{ procedure.langd | default: 0 }},
		"unit": "minutes",
		"system": "http://unitsofmeasure.org",
		"code": "min"
	},
	"extension": [
		{
			"url": "https://canonical.fhir.link/fhir/StructureDefinition/almasoft-is-video",
			"valueBoolean": {{ procedure.isVideo | default: false }}
		}
	],
	"meta": {
		"lastUpdated": "{{ last_updated }}",
		"tag": [
			{
				"system": "https://canonical.fhir.link/fhir/CodeSystem/pms-system",
				"code": "{{ source_system }}"
			}
		]
	}
}
{%- else -%}
{
	"resourceType": "Bundle",
	"type": "searchset",
	"id": "{{ meta.requestId }}",
	"total": {{ procedures.size }},
	"meta": {
		"lastUpdated": "{{ last_updated }}",
		"tag": [
			{
				"system": "https://canonical.fhir.link/fhir/CodeSystem/pms-system",
				"code": "{{ source_system }}"
			}
		]
	},
	"entry": [
		{%- for procedure in procedures -%}
		{
			"fullUrl": "urn:uuid:{{ procedure.kod }}",
			"resource": {
				"resourceType": "ActivityDefinition",
				"id": "{{ procedure.kod }}",
				"status": "active",
				"title": "{{ procedure.namn }}",
				"name": "{{ procedure.namn | replace: ' ', '_' }}",
				"description": "Procedure from Almasoft behandlingstyper.",
				"code": {
					"text": "{{ procedure.namn }}"
				},
				"timingDuration": {
					"value": {{ procedure.langd | default: 0 }},
					"unit": "minutes",
					"system": "http://unitsofmeasure.org",
					"code": "min"
				},
				"extension": [
					{
						"url": "https://canonical.fhir.link/fhir/StructureDefinition/almasoft-is-video",
						"valueBoolean": {{ procedure.isVideo | default: false }}
					}
				],
				"meta": {
					"lastUpdated": "{{ last_updated }}"
				}
			}
		}{%- unless forloop.last -%},{%- endunless -%}
		{%- endfor -%}
	]
}
{%- endif -%}
